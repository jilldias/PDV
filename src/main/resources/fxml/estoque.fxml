<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdv.javafx.controller.EstoqueController" stylesheets="@/css/style.css">
    <top>
        <VBox spacing="10.0" styleClass="dashboard-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <HBox spacing="10.0">
                <Button fx:id="backButton" text="Voltar" />
                <Label styleClass="title-label" text="Controle de Estoque" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <Label text="Buscar produto:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="searchField" promptText="Nome ou código" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="searchButton" text="Buscar" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            </GridPane>
            <Label text="Movimentações de Estoque" styleClass="title-label" />
            <TableView fx:id="movimentacaoTable" prefHeight="400.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="150.0" text="Produto" />
                    <TableColumn prefWidth="100.0" text="Tipo" />
                    <TableColumn prefWidth="100.0" text="Quantidade" />
                    <TableColumn prefWidth="150.0" text="Data" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
