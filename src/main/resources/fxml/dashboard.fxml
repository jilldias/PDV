<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdv.javafx.controller.DashboardController" stylesheets="@/css/style.css">
    <top>
        <VBox spacing="10.0" styleClass="dashboard-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label styleClass="title-label" text="Dashboard PDV" />
            <Label styleClass="subtitle-text" text="Visão geral das operações do caixa e vendas" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button fx:id="vendaButton" styleClass="secondary-button" text="Nova Venda" />
                <Button fx:id="produtosButton" styleClass="secondary-button" text="Produtos" />
                <Button fx:id="estoqueButton" styleClass="secondary-button" text="Estoque" />
                <Button fx:id="caixaButton" styleClass="secondary-button" text="Caixa" />
                <Button fx:id="relatoriosButton" styleClass="secondary-button" text="Relatórios" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <GridPane hgap="20.0" vgap="20.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <Label text="Total Vendido:" styleClass="metric-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="totalVendidoLabel" styleClass="metric-value" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Produtos Cadastrados:" styleClass="metric-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="produtosCadastradosLabel" styleClass="metric-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Vendas do Dia:" styleClass="metric-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="vendasDiaLabel" styleClass="metric-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Estoque Baixo:" styleClass="metric-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="estoqueBaixoLabel" styleClass="metric-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
            <Label text="Vendas Recentes" styleClass="title-label" />
            <TableView fx:id="vendasRecentesTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="75.0" text="Venda" />
                    <TableColumn prefWidth="75.0" text="Funcionário" />
                    <TableColumn prefWidth="75.0" text="Total" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
