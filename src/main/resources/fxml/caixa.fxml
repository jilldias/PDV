<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdv.javafx.controller.CaixaController" stylesheets="@/css/style.css">
    <top>
        <VBox spacing="10.0" styleClass="dashboard-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <HBox spacing="10.0">
                <Button fx:id="backButton" text="Voltar" />
                <Label styleClass="title-label" text="Gestão de Caixa" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <javafx.scene.layout.RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <Label text="Valor Inicial:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="valorInicialField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Valor Final:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="valorFinalField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button fx:id="abrirButton" styleClass="primary-button" text="Abrir Caixa" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Button fx:id="fecharButton" styleClass="primary-button" text="Fechar Caixa" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>
            <Label text="Caixas Registrados" styleClass="title-label" />
            <TableView fx:id="caixaTable" prefHeight="300.0" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="75.0" text="ID" />
                    <TableColumn prefWidth="75.0" text="Status" />
                    <TableColumn prefWidth="150.0" text="Aberto em" />
                    <TableColumn prefWidth="100.0" text="Valor Final" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
