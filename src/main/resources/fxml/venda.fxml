<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdv.javafx.controller.VendaController" stylesheets="@/css/style.css">
    <top>
        <VBox spacing="10.0" styleClass="dashboard-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label styleClass="title-label" text="PDV - Ponto de Venda" />
            <HBox spacing="10.0">
                <Button fx:id="backButton" text="Voltar ao Dashboard" />
                <Label text="Sessão: " />
                <Label fx:id="usuarioLabel" text="Não autenticado" />
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <VBox minWidth="300.0" spacing="10.0" style="-fx-border-color: #ddd; -fx-border-radius: 5;">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                <Label styleClass="title-label" text="Buscar Produto" />
                <TextField fx:id="codigoBarrasField" promptText="Nome ou código de barras" />
                <Button fx:id="buscarButton" styleClass="primary-button" text="Buscar Produto" />
                <Label fx:id="produtoInfoLabel" text="Selecione um produto" wrapText="true" />
                <Spinner fx:id="quantidadeSpinner" prefWidth="150.0" />
                <Button fx:id="adicionarButton" styleClass="primary-button" text="Adicionar ao Carrinho" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                <Label styleClass="title-label" text="Itens da Venda" />
                <TableView fx:id="vendasTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="220.0" text="Produto" fx:id="produtoColumn" />
                        <TableColumn prefWidth="100.0" text="Qtd" fx:id="qtdColumn" />
                        <TableColumn prefWidth="120.0" text="Preço Unit." fx:id="precoColumn" />
                        <TableColumn prefWidth="120.0" text="Subtotal" fx:id="subtotalColumn" />
                        <TableColumn prefWidth="100.0" text="Ação" fx:id="acaoColumn" />
                    </columns>
                </TableView>
                <GridPane hgap="10.0" vgap="10.0">
                    <Label text="Total:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="totalLabel" styleClass="metric-value" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label text="Forma de Pagamento:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <ComboBox fx:id="formaPagamentoCombo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label text="Valor pago:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="valorPagoField" promptText="0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label text="Troco:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="trocoLabel" styleClass="metric-value" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>
                <HBox spacing="10.0">
                    <Button fx:id="cancelarButton" text="Cancelar" />
                    <Button fx:id="finalizarButton" styleClass="primary-button" text="Finalizar Venda" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
